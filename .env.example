# API Keys cho tạo hình ảnh và image prompts
# Copy file này thành .env và điền các API keys thực tế

# OpenAI API Key (cho DALL-E và GPT)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Stability AI API Key (cho Stable Diffusion)
REACT_APP_STABILITY_API_KEY=your_stability_ai_api_key_here

# Google Gemini API Key
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Cách lấy API Keys:

# 1. OpenAI (DALL-E + GPT):
#    - Truy cập: https://platform.openai.com/api-keys
#    - Tạo tài khoản và lấy API key
#    - Chi phí: ~$0.04 per image (DALL-E 3), ~$0.002 per 1K tokens (GPT-3.5)

# 2. Stability AI (Stable Diffusion):
#    - Truy cập: https://platform.stability.ai/account/keys
#    - Tạo tài khoản và lấy API key
#    - Chi phí: ~$0.01 per image

# 3. Google Gemini:
#    - Truy cập: https://makersuite.google.com/app/apikey
#    - Tạo tài khoản và lấy API key
#    - Miễn phí với quota hạn chế

# Lưu ý:
# - Không commit file .env vào git
# - Giữ API keys bảo mật
# - Kiểm tra quota và billing của các service
